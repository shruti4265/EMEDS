@model EMEDS_Project.Models.Prescription

@{
    ViewData["Title"] = "Prescription Details";

    string statusClass =
        Model.Status == "Approved"
            ? "bg-success-subtle text-success"
            : Model.Status == "Rejected"
                ? "bg-danger-subtle text-danger"
                : "bg-warning-subtle text-warning-emphasis";

    string fileName = System.IO.Path.GetFileName(Model.FilePath);
}

<div class="row justify-content-center">

    <div class="col-lg-9">

        <a asp-action="Index"
           class="text-muted text-decoration-none d-inline-block mb-3">
            ← Back to My Prescriptions
        </a>

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

            <div class="card-header bg-white p-4">

                <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">

                    <div>
                        <span class="section-eyebrow">
                            PRESCRIPTION DETAILS
                        </span>

                        <h3 class="fw-bold mb-1 mt-1">
                            Prescription #@Model.PrescriptionId
                        </h3>

                        <p class="text-muted mb-0">
                            Uploaded on
                            @Model.UploadDate.ToString("dd MMMM yyyy 'at' hh:mm tt")
                        </p>
                    </div>

                    <span class="badge rounded-pill @statusClass px-3 py-2">
                        @Model.Status
                    </span>

                </div>

            </div>


            <div class="card-body p-4">

                <div class="row g-3 mb-4">

                    <div class="col-md-6">

                        <div class="prescription-detail-box">

                            <small>PRESCRIPTION ID</small>

                            <strong>
                                #@Model.PrescriptionId
                            </strong>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="prescription-detail-box">

                            <small>MEDICINE</small>

                            @if (Model.Medicine != null)
                            {
                                <strong>
                                    @Model.Medicine.MedicineName
                                </strong>

                                <span class="d-block text-muted small">
                                    Medicine #@Model.MedicineId
                                </span>
                            }
                            else
                            {
                                <strong>
                                    Medicine #@Model.MedicineId
                                </strong>
                            }

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="prescription-detail-box">

                            <small>UPLOAD DATE</small>

                            <strong>
                                @Model.UploadDate.ToString("dd MMM yyyy, hh:mm tt")
                            </strong>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="prescription-detail-box">

                            <small>STATUS</small>

                            <strong>
                                @Model.Status
                            </strong>

                        </div>

                    </div>

                </div>


                <div class="mb-4">

                    <label class="form-label fw-semibold">
                        Admin Remarks
                    </label>

                    <div class="bg-light rounded-3 p-3">

                        @if (string.IsNullOrWhiteSpace(Model.AdminRemarks))
                        {
                            <span class="text-muted">
                                No remarks have been added yet.
                            </span>
                        }
                        else
                        {
                            @Model.AdminRemarks
                        }

                    </div>

                </div>


                <div class="prescription-file-card">

                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                        <div class="d-flex align-items-center gap-3">

                            <div class="prescription-file-icon">
                                Rx
                            </div>

                            <div>

                                <strong class="d-block">
                                    Prescription File
                                </strong>

                                <small class="text-muted">
                                    @fileName
                                </small>

                            </div>

                        </div>


                        <a href="@Model.FilePath"
                           target="_blank"
                           class="btn btn-outline-primary">
                            View Prescription
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>