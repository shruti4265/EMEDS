@model EMEDS_Project.Models.Prescription

@{
    ViewData["Title"] = "Prescription Details";
}

<h1>Prescription Details</h1>

<div>
    <dl class="row">
        <dt class="col-sm-3">Prescription ID</dt>
        <dd class="col-sm-9">@Model.PrescriptionId</dd>

        <dt class="col-sm-3">Upload Date</dt>
        <dd class="col-sm-9">@Model.UploadDate</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>

        <dt class="col-sm-3">Admin Remarks</dt>
        <dd class="col-sm-9">
            @(string.IsNullOrEmpty(Model.AdminRemarks)
                ? "No remarks yet"
                : Model.AdminRemarks)
        </dd>

        <dt class="col-sm-3">Prescription File</dt>
        <dd class="col-sm-9">
            <a href="@Model.FilePath"
               target="_blank"
               class="btn btn-primary">
                View Prescription
            </a>
        </dd>
    </dl>
</div>

<a asp-action="Index">Back to My Prescriptions</a>