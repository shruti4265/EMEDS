@model IEnumerable<EMEDS_Project.Models.Prescription>
@inject EMEDS_Project.Repository.IMedicineRepo MedicineRepo

@{
    ViewData["Title"] = "My Prescriptions";

    var prescriptionMedicines = MedicineRepo.GetAllMedicines()
        .Where(m => m.RequiresPrescription)
        .ToList();
}

<h1>My Prescriptions</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="mb-3">
    <label class="form-label">Upload a new prescription for:</label>
    <form asp-action="Upload" method="get" class="d-flex gap-2">
        <select name="medicineId" class="form-select" style="max-width: 300px;" required>
            <option value="">-- Select Medicine --</option>
            @foreach (var medicine in prescriptionMedicines)
            {
                <option value="@medicine.MedicineId">@medicine.MedicineName</option>
            }
        </select>
        <button type="submit" class="btn btn-primary">Upload Prescription</button>
    </form>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        You have not uploaded any prescriptions yet.
    </div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Prescription ID</th>
                <th>Upload Date</th>
                <th>Status</th>
                <th>Admin Remarks</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var prescription in Model)
            {
                <tr>
                    <td>@prescription.PrescriptionId</td>

                    <td>
                        @prescription.UploadDate.ToString("dd-MM-yyyy")
                    </td>

                    <td>@prescription.Status</td>

                    <td>
                        @(string.IsNullOrEmpty(prescription.AdminRemarks)
                            ? "No remarks"
                            : prescription.AdminRemarks)
                    </td>

                    <td>
                        <a asp-action="Details"
                           asp-route-id="@prescription.PrescriptionId"
                           class="btn btn-primary btn-sm">
                            Details
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}