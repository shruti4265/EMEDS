@model IEnumerable<EMEDS_Project.Models.Prescription>

@{
    ViewData["Title"] = "My Prescriptions";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <span class="section-eyebrow">MY PRESCRIPTIONS</span>
        <h2 class="fw-bold mb-1">My Prescriptions</h2>
        <p class="text-muted mb-0">
            View and manage your uploaded prescriptions.
        </p>
    </div>

    <a asp-controller="Medicine"
       asp-action="Index"
       class="btn btn-primary px-4">
        Browse Medicines
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (Model == null || !Model.Any())
{
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body text-center py-5">

            <div class="prescription-empty-icon mx-auto mb-3">
                Rx
            </div>

            <h4 class="fw-bold">No Prescriptions Yet</h4>

            <p class="text-muted mb-4">
                Your uploaded prescriptions will appear here.
            </p>

            <a asp-controller="Medicine"
               asp-action="Index"
               class="btn btn-primary">
                Browse Medicines
            </a>

        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

        <div class="card-header bg-white p-4">
            <h5 class="fw-bold mb-1">Uploaded Prescriptions</h5>
            <small class="text-muted">
                @Model.Count() prescription@(Model.Count() == 1 ? "" : "s") uploaded
            </small>
        </div>

        <div class="table-responsive">
            <table class="table align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th>Prescription</th>
                        <th>Medicine</th>
                        <th>Upload Date</th>
                        <th>Status</th>
                        <th>Admin Remarks</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model.OrderByDescending(x => x.UploadDate))
                    {
                        string statusClass =
                            item.Status == "Approved"
                                ? "bg-success-subtle text-success"
                                : item.Status == "Rejected"
                                    ? "bg-danger-subtle text-danger"
                                    : "bg-warning-subtle text-warning-emphasis";

                        <tr>

                            <td>
                                <div class="d-flex align-items-center gap-3">

                                    <div class="prescription-table-icon">
                                        Rx
                                    </div>

                                    <div>
                                        <strong class="d-block">
                                            #@item.PrescriptionId
                                        </strong>

                                        <small class="text-muted">
                                            Prescription
                                        </small>
                                    </div>

                                </div>
                            </td>

                            <td>
                                @if (item.Medicine != null)
                                {
                                    <strong>@item.Medicine.MedicineName</strong>

                                    <small class="d-block text-muted">
                                        Medicine #@item.MedicineId
                                    </small>
                                }
                                else
                                {
                                    <span>Medicine #@item.MedicineId</span>
                                }
                            </td>

                            <td>
                                @item.UploadDate.ToString("dd MMM yyyy")

                                <small class="d-block text-muted">
                                    @item.UploadDate.ToString("hh:mm tt")
                                </small>
                            </td>

                            <td>
                                <span class="badge rounded-pill @statusClass px-3 py-2">
                                    @item.Status
                                </span>
                            </td>

                            <td>
                                @if (string.IsNullOrWhiteSpace(item.AdminRemarks))
                                {
                                    <span class="text-muted">—</span>
                                }
                                else
                                {
                                    <span class="prescription-remarks"
                                          title="@item.AdminRemarks">
                                        @item.AdminRemarks
                                    </span>
                                }
                            </td>

                            <td class="text-end">
                                <a asp-action="Details"
                                   asp-route-id="@item.PrescriptionId"
                                   class="btn btn-outline-primary btn-sm">
                                    View Details
                                </a>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>
        </div>

    </div>
}