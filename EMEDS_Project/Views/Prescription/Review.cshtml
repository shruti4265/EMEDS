@model EMEDS_Project.Models.Prescription

@{
    ViewData["Title"] = "Review Prescription";

    string statusClass =
        Model.Status == "Approved"
            ? "bg-success-subtle text-success"
            : Model.Status == "Rejected"
                ? "bg-danger-subtle text-danger"
                : "bg-warning-subtle text-warning-emphasis";

    string fileName = System.IO.Path.GetFileName(Model.FilePath);
}


<div class="mb-4">

    <a asp-action="ManagePrescriptions"
       class="text-decoration-none text-muted d-inline-block mb-3">
        ← Back to Manage Prescriptions
    </a>

    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">

        <div>

            <span class="section-eyebrow">
                ADMIN REVIEW
            </span>

            <h2 class="fw-bold mb-1">
                Review Prescription #@Model.PrescriptionId
            </h2>

            <p class="text-muted mb-0">
                Review the submitted prescription and approve or reject it.
            </p>

        </div>


        <span class="badge rounded-pill @statusClass px-3 py-2">
            @Model.Status
        </span>

    </div>

</div>


<div class="row g-4">

    <!-- LEFT SIDE -->
    <div class="col-lg-7">

        <div class="card border-0 shadow-sm rounded-4 h-100">

            <div class="card-header bg-white p-4">

                <h5 class="fw-bold mb-1">
                    Prescription Information
                </h5>

                <small class="text-muted">
                    Customer prescription details
                </small>

            </div>


            <div class="card-body p-4">

                <div class="row g-3">

                    <div class="col-md-6">

                        <div class="prescription-detail-box">

                            <small>
                                PRESCRIPTION ID
                            </small>

                            <strong>
                                #@Model.PrescriptionId
                            </strong>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="prescription-detail-box">

                            <small>
                                MEDICINE
                            </small>

                            @if (Model.Medicine != null)
                            {
                                <strong>
                                    @Model.Medicine.MedicineName
                                </strong>

                                <span class="d-block small text-muted">
                                    Medicine #@Model.MedicineId
                                </span>
                            }
                            else
                            {
                                <strong>
                                    Medicine #@Model.MedicineId
                                </strong>
                            }

                        </div>

                    </div>


                    <div class="col-12">

                        <div class="prescription-detail-box">

                            <small>
                                CUSTOMER ID
                            </small>

                            <strong class="text-break">
                                @Model.UserId
                            </strong>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="prescription-detail-box">

                            <small>
                                UPLOAD DATE
                            </small>

                            <strong>
                                @Model.UploadDate.ToString("dd MMM yyyy")
                            </strong>

                            <span class="d-block small text-muted">
                                @Model.UploadDate.ToString("hh:mm tt")
                            </span>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="prescription-detail-box">

                            <small>
                                CURRENT STATUS
                            </small>

                            <strong>
                                @Model.Status
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- FILE -->
                <div class="prescription-file-card mt-4">

                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                        <div class="d-flex align-items-center gap-3">

                            <div class="prescription-file-icon">
                                Rx
                            </div>

                            <div>

                                <strong class="d-block">
                                    Prescription File
                                </strong>

                                <small class="text-muted">
                                    @fileName
                                </small>

                            </div>

                        </div>


                        <a href="@Model.FilePath"
                           target="_blank"
                           class="btn btn-outline-primary">

                            Open Prescription

                        </a>

                    </div>

                </div>


                @if (!string.IsNullOrWhiteSpace(Model.AdminRemarks))
                {
                    <div class="mt-4">

                        <label class="form-label fw-semibold">
                            Previous Admin Remarks
                        </label>

                        <div class="bg-light rounded-3 p-3">
                            @Model.AdminRemarks
                        </div>

                    </div>
                }

            </div>

        </div>

    </div>


    <!-- RIGHT SIDE -->
    <div class="col-lg-5">

        <div class="card border-0 shadow-sm rounded-4">

            <div class="card-header bg-white p-4">

                <h5 class="fw-bold mb-1">
                    Verification
                </h5>

                <small class="text-muted">
                    Approve or reject this prescription
                </small>

            </div>


            <div class="card-body p-4">

                <div class="mb-4">

                    <label for="adminRemarks"
                           class="form-label fw-semibold">

                        Admin Remarks

                    </label>

                    <textarea id="adminRemarks"
                              class="form-control"
                              rows="5"
                              placeholder="Enter remarks for the customer...">@Model.AdminRemarks</textarea>

                    <small class="text-muted">
                        You can add a reason or note before approving or rejecting.
                    </small>

                </div>


                <!-- APPROVE FORM -->
                <form asp-action="Approve"
                      method="post"
                      class="mb-2"
                      onsubmit="copyRemarksToApprove()">

                    <!-- matches Approve(int id, ...) -->
                    <input type="hidden"
                           name="id"
                           value="@Model.PrescriptionId" />

                    <!-- matches string? adminRemarks -->
                    <input type="hidden"
                           id="approveRemarks"
                           name="adminRemarks" />

                    <button type="submit"
                            class="btn btn-success w-100">

                        ✓ Approve Prescription

                    </button>

                </form>


                <!-- REJECT FORM -->
                <form asp-action="Reject"
                      method="post"
                      onsubmit="copyRemarksToReject()">

                    <!-- matches Reject(int id, ...) -->
                    <input type="hidden"
                           name="id"
                           value="@Model.PrescriptionId" />

                    <!-- matches string? adminRemarks -->
                    <input type="hidden"
                           id="rejectRemarks"
                           name="adminRemarks" />

                    <button type="submit"
                            class="btn btn-outline-danger w-100">

                        Reject Prescription

                    </button>

                </form>


                <div class="alert prescription-info-alert small mt-4 mb-0">

                    <strong>Current Status:</strong>
                    @Model.Status

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        function copyRemarksToApprove() {

            document.getElementById("approveRemarks").value =
                document.getElementById("adminRemarks").value;
        }


        function copyRemarksToReject() {

            document.getElementById("rejectRemarks").value =
                document.getElementById("adminRemarks").value;
        }

    </script>

}