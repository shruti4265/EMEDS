@model EMEDS_Project.Models.Prescription

@{
    ViewData["Title"] = "Review Prescription";
}

<div class="container py-4">

    <div class="mb-3">
        <a asp-action="ManagePrescriptions"
           class="text-decoration-none">
            ← Back to Prescriptions
        </a>
    </div>


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-circle me-2"></i>
            @TempData["Error"]
        </div>
    }


    <div class="row g-4">

        <!-- PRESCRIPTION INFORMATION -->

        <div class="col-lg-7">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4">

                    <span class="section-eyebrow">
                        ADMIN REVIEW
                    </span>

                    <h2 class="fw-bold mb-4">
                        Prescription #@Model.PrescriptionId
                    </h2>


                    <div class="row g-3">

                        <div class="col-md-6">
                            <small class="text-muted d-block">
                                Medicine
                            </small>

                            <strong>
                                @(Model.Medicine?.MedicineName
                                    ?? $"Medicine #{Model.MedicineId}")
                            </strong>
                        </div>


                        <div class="col-md-6">
                            <small class="text-muted d-block">
                                Uploaded On
                            </small>

                            <strong>
                                @Model.UploadDate.ToString("dd MMM yyyy, hh:mm tt")
                            </strong>
                        </div>


                        <div class="col-md-6">
                            <small class="text-muted d-block">
                                Customer
                            </small>

                            <strong>
                                @Model.UserId
                            </strong>
                        </div>


                        <div class="col-md-6">
                            <small class="text-muted d-block">
                                Related Order
                            </small>

                            @if (Model.OrderId.HasValue)
                            {
                                <strong>
                                    #@Model.OrderId
                                </strong>
                            }
                            else
                            {
                                <span class="text-muted">
                                    Not linked
                                </span>
                            }
                        </div>


                        <div class="col-md-6">
                            <small class="text-muted d-block mb-1">
                                Status
                            </small>

                            @if (Model.Status == "Approved")
                            {
                                <span class="badge bg-success">
                                    Approved
                                </span>
                            }
                            else if (Model.Status == "Rejected")
                            {
                                <span class="badge bg-danger">
                                    Rejected
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    Pending
                                </span>
                            }
                        </div>

                    </div>


                    <hr class="my-4" />


                    <div class="mb-3">

                        <small class="text-muted d-block mb-2">
                            Prescription File
                        </small>

                        <a href="@Model.FilePath"
                           target="_blank"
                           class="btn btn-outline-primary">

                            <i class="bi bi-file-earmark-medical me-1"></i>
                            View Prescription

                        </a>

                    </div>


                    @if (Model.OrderId.HasValue)
                    {
                        <a asp-controller="Order"
                           asp-action="AdminDetails"
                           asp-route-id="@Model.OrderId"
                           class="btn btn-outline-secondary">

                            <i class="bi bi-box-seam me-1"></i>
                            View Related Order

                        </a>
                    }


                    @if (!string.IsNullOrWhiteSpace(Model.AdminRemarks))
                    {
                        <div class="alert alert-light border mt-4 mb-0">

                            <strong>Admin Remarks</strong>

                            <div class="mt-1">
                                @Model.AdminRemarks
                            </div>

                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- ADMIN ACTION -->

        <div class="col-lg-5">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4">

                    <span class="section-eyebrow">
                        REVIEW ACTION
                    </span>

                    <h4 class="fw-bold mb-2">
                        Review Prescription
                    </h4>

                    <p class="text-muted">
                        Approval will not affect the order.
                        Rejection will cancel the related order.
                    </p>


                    @if (Model.Status == "Pending")
                    {
                        <!-- APPROVE -->

                        <form asp-action="Approve"
                              method="post"
                              class="mb-3">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@Model.PrescriptionId" />

                            <div class="mb-3">

                                <label class="form-label">
                                    Remarks
                                    <span class="text-muted">
                                        (Optional)
                                    </span>
                                </label>

                                <textarea name="adminRemarks"
                                          class="form-control"
                                          rows="3"
                                          placeholder="Add remarks if required..."></textarea>

                            </div>

                            <button type="submit"
                                    class="btn btn-success w-100">

                                <i class="bi bi-check-circle me-1"></i>
                                Approve Prescription

                            </button>

                        </form>


                        <!-- REJECT -->

                        <form asp-action="Reject"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@Model.PrescriptionId" />

                            <div class="mb-3">

                                <label class="form-label">
                                    Rejection Reason
                                    <span class="text-muted">
                                        (Optional)
                                    </span>
                                </label>

                                <textarea name="adminRemarks"
                                          class="form-control"
                                          rows="3"
                                          placeholder="Reason for rejection..."></textarea>

                            </div>

                            <button type="submit"
                                    class="btn btn-danger w-100"
                                    onclick="return confirm('Reject this prescription? The related order will be cancelled.');">

                                <i class="bi bi-x-circle me-1"></i>
                                Reject Prescription

                            </button>

                        </form>
                    }
                    else
                    {
                        <div class="alert alert-light border mb-0">

                            This prescription has already been
                            <strong>@Model.Status.ToLower()</strong>.

                            @if (Model.Status == "Rejected")
                            {
                                <div class="text-danger mt-2">
                                    The related order has been cancelled
                                    if it was still active.
                                </div>
                            }

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>