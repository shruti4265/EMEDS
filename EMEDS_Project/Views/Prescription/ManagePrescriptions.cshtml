
@model IEnumerable<EMEDS_Project.Models.Prescription>

@{
    ViewData["Title"] = "Manage Prescriptions";

    int totalPrescriptions = Model.Count();
    int pendingPrescriptions = Model.Count(p => p.Status == "Pending");
    int approvedPrescriptions = Model.Count(p => p.Status == "Approved");
    int rejectedPrescriptions = Model.Count(p => p.Status == "Rejected");
}

<div class="container py-4">

    <!-- PAGE HEADER -->

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>
            <span class="section-eyebrow">
                ADMINISTRATION
            </span>

            <h2 class="fw-bold mb-1">
                Manage Prescriptions
            </h2>

            <p class="text-muted mb-0">
                Review and manage customer prescriptions.
            </p>
        </div>

    </div>


    <!-- MESSAGES -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-circle me-2"></i>
            @TempData["Error"]
        </div>
    }


    <!-- SUMMARY CARDS -->

    <div class="row g-3 mb-4">

        <div class="col-md-6 col-xl-3">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Total Prescriptions
                    </small>

                    <h3 class="fw-bold mt-2 mb-0">
                        @totalPrescriptions
                    </h3>

                </div>

            </div>

        </div>


        <div class="col-md-6 col-xl-3">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Pending Review
                    </small>

                    <h3 class="fw-bold mt-2 mb-0">
                        @pendingPrescriptions
                    </h3>

                </div>

            </div>

        </div>


        <div class="col-md-6 col-xl-3">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Approved
                    </small>

                    <h3 class="fw-bold mt-2 mb-0">
                        @approvedPrescriptions
                    </h3>

                </div>

            </div>

        </div>


        <div class="col-md-6 col-xl-3">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Rejected
                    </small>

                    <h3 class="fw-bold mt-2 mb-0">
                        @rejectedPrescriptions
                    </h3>

                </div>

            </div>

        </div>

    </div>


    <!-- PRESCRIPTION TABLE -->

    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-0">

            @if (!Model.Any())
            {
                <div class="text-center py-5">

                    <i class="bi bi-file-earmark-medical fs-1 text-muted"></i>

                    <h5 class="mt-3">
                        No prescriptions found
                    </h5>

                    <p class="text-muted mb-0">
                        Customer prescriptions will appear here.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead>

                            <tr>

                                <th class="ps-4">
                                    ID
                                </th>

                                <th>
                                    Order
                                </th>

                                <th>
                                    Medicine
                                </th>

                                <th>
                                    Customer
                                </th>

                                <th>
                                    Uploaded
                                </th>

                                <th>
                                    Status
                                </th>

                                <th class="text-end pe-4">
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <!-- PRESCRIPTION ID -->

                                    <td class="ps-4">

                                        <strong>
                                            #@item.PrescriptionId
                                        </strong>

                                    </td>


                                    <!-- RELATED ORDER -->

                                    <td>

                                        @if (item.OrderId.HasValue)
                                        {
                                            <a asp-controller="Order"
                                               asp-action="AdminDetails"
                                               asp-route-id="@item.OrderId"
                                               class="text-decoration-none fw-semibold">

                                                #@item.OrderId

                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Not linked
                                            </span>
                                        }

                                    </td>


                                    <!-- MEDICINE -->

                                    <td>

                                        <strong>
                                            @(item.Medicine?.MedicineName
                                                ?? $"Medicine #{item.MedicineId}")
                                        </strong>

                                    </td>


                                    <!-- CUSTOMER -->

                                    <td>

                                        <span class="small">
                                            @item.UserId
                                        </span>

                                    </td>


                                    <!-- UPLOAD DATE -->

                                    <td>

                                        <span>
                                            @item.UploadDate.ToString("dd MMM yyyy")
                                        </span>

                                        <small class="text-muted d-block">
                                            @item.UploadDate.ToString("hh:mm tt")
                                        </small>

                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        @if (item.Status == "Approved")
                                        {
                                            <span class="badge bg-success">
                                                Approved
                                            </span>
                                        }
                                        else if (item.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger">
                                                Rejected
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }

                                    </td>


                                    <!-- ACTION -->

                                    <td class="text-end pe-4">

                                        <a asp-action="Review"
                                           asp-route-id="@item.PrescriptionId"
                                           class="btn btn-outline-primary btn-sm">

                                            @if (item.Status == "Pending")
                                            {
                                                <i class="bi bi-eye me-1"></i>
                                                <span>Review</span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-eye me-1"></i>
                                                <span>View</span>
                                            }

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>