
@{
    ViewData["Title"] = "Upload Prescription";

    int medicineId = ViewBag.MedicineId;
    int orderId = ViewBag.OrderId;
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-lg-7 col-md-9">

            <div class="card shadow-sm border-0 rounded-4">

                <div class="card-body p-4 p-md-5">

                    <div class="mb-4">

                        <span class="section-eyebrow">
                            PRESCRIPTION
                        </span>

                        <h2 class="fw-bold mb-2">
                            Upload Prescription
                        </h2>

                        <p class="text-muted mb-0">
                            Upload a valid prescription for this medicine.
                            Your order will continue normally while the
                            prescription is pending review.
                        </p>

                    </div>


                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-circle me-2"></i>
                            @TempData["Error"]
                        </div>
                    }


                    <form asp-controller="Prescription"
                          asp-action="Upload"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()


                        <input type="hidden"
                               name="medicineId"
                               value="@medicineId" />


                        <input type="hidden"
                               name="orderId"
                               value="@orderId" />


                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                Prescription File
                            </label>

                            <input type="file"
                                   name="prescriptionFile"
                                   class="form-control"
                                   accept=".jpg,.jpeg,.png,.pdf"
                                   required />

                            <div class="form-text mt-2">
                                Allowed formats: JPG, JPEG, PNG and PDF.
                                Maximum file size: 5 MB.
                            </div>

                        </div>


                        <div class="alert alert-light border">

                            <div class="d-flex gap-2">

                                <i class="bi bi-info-circle"></i>

                                <div>

                                    <strong>
                                        Prescription review does not block your order.
                                    </strong>

                                    <div class="small text-muted mt-1">
                                        Your order will continue through the normal
                                        order process unless the prescription is
                                        rejected by the admin.
                                    </div>

                                </div>

                            </div>

                        </div>


                        <div class="d-flex gap-2 mt-4">

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="bi bi-upload me-1"></i>
                                Upload Prescription

                            </button>


                            <a asp-controller="Order"
                               asp-action="Details"
                               asp-route-id="@orderId"
                               class="btn btn-outline-secondary">

                                Back to Order

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>