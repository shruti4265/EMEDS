@model List<EMEDS_Project.Models.CartItem>

@{
    ViewData["Title"] = "Shopping Cart";

    decimal grandTotal = Model.Sum(x => x.TotalPrice);
    int totalItems = Model.Sum(x => x.Quantity);
}

<div class="container mt-4">
    <h2>Shopping Cart</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (!Model.Any())
    {
        <p class="text-muted">Your cart is empty.</p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Medicine</th>
                    <th>Unit Price</th>
                    <th>Quantity</th>
                    <th>Subtotal</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.MedicineName</td>
                        <td>@item.UnitPrice.ToString("C")</td>
                        <td>
                            <form asp-action="UpdateCartItem" method="post" class="d-flex align-items-center gap-2">
                                <input type="hidden" name="medicineId" value="@item.MedicineId" />
                                <input type="number" name="quantity" value="@item.Quantity" min="0" class="form-control form-control-sm" style="width: 70px;" />
                                <button type="submit" class="btn btn-sm btn-outline-primary">Update</button>
                            </form>
                        </td>
                        <td>@item.TotalPrice.ToString("C")</td>
                        <td>
                            <form asp-action="RemoveFromCart" method="post">
                                <input type="hidden" name="medicineId" value="@item.MedicineId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="d-flex justify-content-between align-items-center">
            <form asp-action="ClearCart" method="post">
                <button type="submit" class="btn btn-outline-secondary">Clear Cart</button>
            </form>

            <div>
                <h4>Total: @grandTotal.ToString("C") (@totalItems items)</h4>
                <a asp-controller="Checkout" asp-action="Index" class="btn btn-success btn-lg">Proceed to Checkout</a>
            </div>
        </div>
    }
</div>