
@model List<EMEDS_Project.Models.CartItem>

@{
    ViewData["Title"] = "Shopping Cart";

    decimal grandTotal = Model.Sum(x => x.TotalPrice);
    int totalItems = Model.Sum(x => x.Quantity);
}

<div class="page-header">
    <span class="section-eyebrow">YOUR SELECTION</span>
    <h2>Shopping Cart</h2>
    <p class="page-subtitle">
        Review your medicines and quantities before checkout.
    </p>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mb-4">
        @TempData["Error"]
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-4">
        @TempData["Success"]
    </div>
}

@if (!Model.Any())
{
    <div class="cart-empty-state">

        <div class="cart-empty-icon">
            C
        </div>

        <h3>Your cart is empty</h3>

        <p>
            You haven't added any medicines to your cart yet.
            Browse the catalogue to get started.
        </p>

        <a asp-controller="Medicine"
           asp-action="Index"
           class="btn btn-primary">
            Browse Medicines
        </a>

    </div>
}
else
{
    <div class="row g-4">

        <!-- CART ITEMS -->

        <div class="col-lg-8">

            <div class="cart-panel">

                <div class="cart-panel-header">

                    <div>
                        <h4>Cart Items</h4>
                        <p>
                            @totalItems item@(totalItems == 1 ? "" : "s") in your cart
                        </p>
                    </div>

                    <form asp-action="ClearCart"
                          method="post">

                        <button type="submit"
                                class="btn btn-light btn-sm">
                            Clear Cart
                        </button>

                    </form>

                </div>


                <div class="cart-items">

                    @foreach (var item in Model)
                    {
                        <div class="cart-item">

                            <div class="cart-medicine-icon">
                                +
                            </div>


                            <div class="cart-item-info">

                                <span class="cart-item-label">
                                    MEDICINE
                                </span>

                                <h5>
                                    @item.MedicineName
                                </h5>

                                <p>
                                    Unit Price:
                                    <strong>
                                        ₹@item.UnitPrice.ToString("0.00")
                                    </strong>
                                </p>

                            </div>


                            <!-- QUANTITY -->

                            <div class="cart-quantity">

                                <span class="cart-item-label">
                                    QUANTITY
                                </span>

                                <form asp-action="UpdateCartItem"
                                      method="post"
                                      class="quantity-form">

                                    <input type="hidden"
                                           name="medicineId"
                                           value="@item.MedicineId" />

                                    <input type="number"
                                           name="quantity"
                                           value="@item.Quantity"
                                           min="0"
                                           class="form-control" />

                                    <button type="submit"
                                            class="btn btn-outline-primary btn-sm">
                                        Update
                                    </button>

                                </form>

                            </div>


                            <!-- SUBTOTAL -->

                            <div class="cart-subtotal">

                                <span class="cart-item-label">
                                    SUBTOTAL
                                </span>

                                <strong>
                                    ₹@item.TotalPrice.ToString("0.00")
                                </strong>

                            </div>


                            <!-- REMOVE -->

                            <div class="cart-remove">

                                <form asp-action="RemoveFromCart"
                                      method="post">

                                    <input type="hidden"
                                           name="medicineId"
                                           value="@item.MedicineId" />

                                    <button type="submit"
                                            class="cart-remove-btn"
                                            title="Remove medicine">
                                        ×
                                    </button>

                                </form>

                            </div>

                        </div>
                    }

                </div>

            </div>


            <div class="cart-continue">

                <a asp-controller="Medicine"
                   asp-action="Index">
                    ← Continue Shopping
                </a>

            </div>

        </div>


        <!-- ORDER SUMMARY -->

        <div class="col-lg-4">

            <div class="cart-summary">

                <span class="section-eyebrow">
                    ORDER SUMMARY
                </span>

                <h4>Summary</h4>


                <div class="summary-line">

                    <span>Total Items</span>

                    <strong>
                        @totalItems
                    </strong>

                </div>


                <div class="summary-line">

                    <span>Subtotal</span>

                    <strong>
                        ₹@grandTotal.ToString("0.00")
                    </strong>

                </div>


                <div class="summary-line">

                    <span>Delivery</span>

                    <strong class="summary-free">
                        Included
                    </strong>

                </div>


                <div class="summary-total">

                    <span>Total Amount</span>

                    <strong>
                        ₹@grandTotal.ToString("0.00")
                    </strong>

                </div>


                <a asp-controller="Checkout"
                   asp-action="Index"
                   class="btn btn-primary btn-lg w-100">
                    Proceed to Checkout
                </a>


                <div class="summary-note">

                    <span>✓</span>

                    <p>
                        Stock and prescription requirements
                        are validated before your order is placed.
                    </p>

                </div>

            </div>

        </div>

    </div>
}
