@model EMEDS_Project.Models.Supplier

@{
    ViewData["Title"] = "Delete Supplier";
}

<div class="container mt-4 animate-fadeInUp">

    <div class="page-header text-center mb-4">
        <h2 class="text-danger">Delete Supplier</h2>
        <p class="page-subtitle text-muted">Are you sure you want to delete this supplier?</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="form-card">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Supplier Name</dt>
                    <dd class="col-sm-8">@Model.SupplierName</dd>

                    <dt class="col-sm-4">Contact Person</dt>
                    <dd class="col-sm-8">@Model.ContactPerson</dd>

                    <dt class="col-sm-4">Phone Number</dt>
                    <dd class="col-sm-8">@Model.PhoneNumber</dd>

                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>
                </dl>

                <form asp-action="DeleteConfirmed" asp-route-id="@Model.SupplierId" method="post" class="mt-4">
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary btn-pill">
                            <i class="bi bi-arrow-left"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-danger btn-pill">
                            <i class="bi bi-trash3"></i> Delete
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

</div>