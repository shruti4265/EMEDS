@model EMEDS_Project.Models.Supplier

@{
    ViewData["Title"] = "Delete Supplier";
}

<div class="container-fluid px-0">

    <div class="mb-3">
        <a asp-action="Index" class="text-decoration-none text-muted">
            ← Back to Suppliers
        </a>
    </div>

    <div class="row justify-content-center">

        <div class="col-lg-7 col-xl-6">

            <div class="text-center mb-4">

                <div class="supplier-delete-icon mx-auto mb-3">
                    !
                </div>

                <span class="section-eyebrow">SUPPLIERS</span>

                <h2 class="fw-bold mb-2">
                    Delete Supplier?
                </h2>

                <p class="text-muted mb-0">
                    Are you sure you want to delete this supplier?
                </p>

            </div>

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4 p-md-5">

                    <div class="supplier-delete-summary mb-4">

                        <h5 class="fw-bold mb-1">
                            @Model.SupplierName
                        </h5>

                        <small class="text-muted">
                            Supplier #@Model.SupplierId
                        </small>

                        <hr />

                        <div class="row g-3">

                            <div class="col-md-6">
                                <small class="text-muted d-block">
                                    Contact Person
                                </small>
                                <strong>@Model.ContactPerson</strong>
                            </div>

                            <div class="col-md-6">
                                <small class="text-muted d-block">
                                    Phone Number
                                </small>
                                <strong>@Model.PhoneNumber</strong>
                            </div>

                            <div class="col-12">
                                <small class="text-muted d-block">
                                    Email
                                </small>
                                <strong>@Model.Email</strong>
                            </div>

                            <div class="col-12">
                                <small class="text-muted d-block">
                                    Address
                                </small>
                                <strong>@Model.Address</strong>
                            </div>

                        </div>

                    </div>

                    <div class="alert alert-danger">
                        <strong>Warning:</strong>
                        This action will permanently remove the supplier.
                    </div>

                    <form asp-action="DeleteConfirmed"
                          asp-route-id="@Model.SupplierId"
                          method="post">

                        <div class="d-flex gap-2 flex-wrap">

                            <button type="submit"
                                    class="btn btn-danger px-4">
                                Delete Supplier
                            </button>

                            <a asp-action="Details"
                               asp-route-id="@Model.SupplierId"
                               class="btn btn-light px-4">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>