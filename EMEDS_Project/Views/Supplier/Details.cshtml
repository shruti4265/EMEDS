@model EMEDS_Project.Models.Supplier

@{
    ViewData["Title"] = "Supplier Details";
}

<div class="container-fluid px-0">

    <div class="mb-3">
        <a asp-action="Index" class="text-decoration-none text-muted">
            ← Back to Suppliers
        </a>
    </div>

    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">

        <div>
            <span class="section-eyebrow">SUPPLIERS</span>
            <h2 class="fw-bold mb-1">Supplier Details</h2>
            <p class="text-muted mb-0">
                View supplier and contact information.
            </p>
        </div>

        <a asp-action="Edit"
           asp-route-id="@Model.SupplierId"
           class="btn btn-primary px-4">
            Edit Supplier
        </a>

    </div>

    <div class="row g-4">

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-header bg-white p-4">

                    <div class="d-flex align-items-center gap-3">

                        <div class="supplier-profile-icon">
                            S
                        </div>

                        <div>
                            <h5 class="fw-bold mb-1">
                                @Model.SupplierName
                            </h5>

                            <small class="text-muted">
                                Supplier #@Model.SupplierId
                            </small>
                        </div>

                    </div>

                </div>

                <div class="card-body p-4">

                    <div class="row g-3">

                        <div class="col-md-6">
                            <div class="supplier-detail-box">
                                <small>SUPPLIER NAME</small>
                                <strong>@Model.SupplierName</strong>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="supplier-detail-box">
                                <small>CONTACT PERSON</small>
                                <strong>@Model.ContactPerson</strong>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="supplier-detail-box">
                                <small>PHONE NUMBER</small>
                                <strong>@Model.PhoneNumber</strong>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="supplier-detail-box">
                                <small>EMAIL ADDRESS</small>

                                <a href="mailto:@Model.Email"
                                   class="text-decoration-none fw-semibold supplier-email">
                                    @Model.Email
                                </a>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="supplier-detail-box">
                                <small>ADDRESS</small>
                                <strong>@Model.Address</strong>
                            </div>
                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-header bg-white p-4">
                    <h5 class="fw-bold mb-1">Quick Actions</h5>
                    <small class="text-muted">
                        Manage this supplier
                    </small>
                </div>

                <div class="card-body p-4">

                    <a asp-action="Edit"
                       asp-route-id="@Model.SupplierId"
                       class="btn btn-primary w-100 mb-2">
                        Edit Supplier
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@Model.SupplierId"
                       class="btn btn-outline-danger w-100 mb-2">
                        Delete Supplier
                    </a>

                    <a asp-action="Index"
                       class="btn btn-light w-100">
                        Back to Suppliers
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>