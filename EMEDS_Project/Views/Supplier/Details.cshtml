@model EMEDS_Project.Models.Supplier

@{
    ViewData["Title"] = "Supplier Details";
}

<div class="container mt-4 animate-fadeInUp">

    <div class="page-header mb-4">
        <h2>Supplier Details</h2>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="form-card">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Supplier ID</dt>
                    <dd class="col-sm-8">@Model.SupplierId</dd>

                    <dt class="col-sm-4">Supplier Name</dt>
                    <dd class="col-sm-8">@Model.SupplierName</dd>

                    <dt class="col-sm-4">Contact Person</dt>
                    <dd class="col-sm-8">@Model.ContactPerson</dd>

                    <dt class="col-sm-4">Phone Number</dt>
                    <dd class="col-sm-8">@Model.PhoneNumber</dd>

                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4">Address</dt>
                    <dd class="col-sm-8">@Model.Address</dd>
                </dl>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary btn-pill">
                        <i class="bi bi-arrow-left"></i> Back
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.SupplierId" class="btn btn-warning btn-pill">
                        <i class="bi bi-pencil-square"></i> Edit
                    </a>
                </div>
            </div>
        </div>
    </div>

</div>