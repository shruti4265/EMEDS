@model IEnumerable<EMEDS_Project.Models.Supplier>

@{
    ViewData["Title"] = "Suppliers";
    int totalSuppliers = Model.Count();
}

<div class="container-fluid px-0">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <span class="section-eyebrow">ADMINISTRATION</span>
            <h2 class="fw-bold mb-1">Supplier Management</h2>
            <p class="text-muted mb-0">
                Manage medicine suppliers and their contact information.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary px-4">
            + Add Supplier
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <small class="text-muted d-block mb-2">Total Suppliers</small>
                    <h2 class="supplier-stat-number fw-bold mb-1">
                        @totalSuppliers
                    </h2>
                    <small class="text-muted">Registered suppliers</small>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

        <div class="card-header bg-white p-4">
            <h5 class="fw-bold mb-1">Registered Suppliers</h5>
            <small class="text-muted">
                @totalSuppliers supplier@(totalSuppliers == 1 ? "" : "s") found
            </small>
        </div>

        @if (!Model.Any())
        {
            <div class="card-body text-center py-5">

                <div class="supplier-empty-icon mx-auto mb-3">
                    S
                </div>

                <h5 class="fw-bold">No Suppliers Available</h5>

                <p class="text-muted mb-4">
                    Add your first supplier to start managing supplier information.
                </p>

                <a asp-action="Create" class="btn btn-primary">
                    + Add Supplier
                </a>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Supplier</th>
                            <th>Contact Person</th>
                            <th>Phone Number</th>
                            <th>Email</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var supplier in Model)
                        {
                            <tr>

                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">

                                        <div class="supplier-table-icon">
                                            S
                                        </div>

                                        <div>
                                            <strong class="d-block">
                                                @supplier.SupplierName
                                            </strong>

                                            <small class="text-muted">
                                                Supplier #@supplier.SupplierId
                                            </small>
                                        </div>

                                    </div>
                                </td>

                                <td>
                                    @supplier.ContactPerson
                                </td>

                                <td>
                                    @supplier.PhoneNumber
                                </td>

                                <td>
                                    <a href="mailto:@supplier.Email"
                                       class="text-decoration-none supplier-email">
                                        @supplier.Email
                                    </a>
                                </td>

                                <td class="text-end pe-4">

                                    <div class="d-flex justify-content-end gap-2 flex-wrap">

                                        <a asp-action="Details"
                                           asp-route-id="@supplier.SupplierId"
                                           class="btn btn-outline-primary btn-sm">
                                            Details
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@supplier.SupplierId"
                                           class="btn btn-outline-secondary btn-sm">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@supplier.SupplierId"
                                           class="btn btn-outline-danger btn-sm">
                                            Delete
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>