@model IEnumerable<EMEDS_Project.Models.Supplier>

@{
    ViewData["Title"] = "Suppliers";
}

<div class="container mt-4 animate-fadeInUp">

    <div class="page-header d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Suppliers</h2>
            <p class="page-subtitle text-muted">Manage medicine suppliers</p>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-pill">
            <i class="bi bi-plus-lg"></i> Add Supplier
        </a>
    </div>

    <div class="emeds-table-wrap">
        <div class="table-responsive">
            <table class="table emeds-table mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Supplier ID</th>
                        <th>Supplier Name</th>
                        <th>Contact Person</th>
                        <th>Phone Number</th>
                        <th>Email</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var supplier in Model)
                    {
                        <tr>
                            <td>@supplier.SupplierId</td>
                            <td>@supplier.SupplierName</td>
                            <td>@supplier.ContactPerson</td>
                            <td>@supplier.PhoneNumber</td>
                            <td>@supplier.Email</td>
                            <td>
                                <a asp-action="Details"
                                   asp-route-id="@supplier.SupplierId"
                                   class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-eye"></i> Details
                                </a>
                                <a asp-action="Edit"
                                   asp-route-id="@supplier.SupplierId"
                                   class="btn btn-warning btn-sm">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </a>
                                <a asp-action="Delete"
                                   asp-route-id="@supplier.SupplierId"
                                   class="btn btn-danger btn-sm">
                                    <i class="bi bi-trash3"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>