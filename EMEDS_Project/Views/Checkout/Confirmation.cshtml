
@model EMEDS_Project.Models.Order

@{
    ViewData["Title"] = "Order Confirmation";
}

<div class="confirmation-wrapper">

    <!-- SUCCESS -->

    <div class="confirmation-success">

        <div class="confirmation-check">
            ✓
        </div>

        <span class="section-eyebrow">
            ORDER CONFIRMED
        </span>

        <h1>Thank you for your order!</h1>

        <p>
            Your order has been placed successfully.
            You can follow its progress from My Orders.
        </p>

    </div>


    <!-- ORDER CARD -->

    <div class="confirmation-card">

        <div class="confirmation-card-header">

            <div>

                <small>ORDER NUMBER</small>

                <h4>
                    #@Model.OrderId
                </h4>

            </div>


            <span class="order-status-pill">
                @Model.OrderStatus
            </span>

        </div>


        <div class="confirmation-info-grid">

            <div>

                <span>Order Date</span>

                <strong>
                    @Model.OrderDate.ToString("dd MMM yyyy, hh:mm tt")
                </strong>

            </div>


            <div>

                <span>Payment Status</span>

                <strong>
                    @ViewBag.PaymentStatus
                </strong>

            </div>


            <div class="confirmation-address">

                <span>Delivery Address</span>

                <strong>
                    @Model.DeliveryAddress
                </strong>

            </div>

        </div>


        <!-- ITEMS -->

        <div class="confirmation-items">

            <h5>Order Items</h5>


            @foreach (var item in Model.OrderItems)
            {
                <div class="confirmation-item">

                    <div class="confirmation-item-icon">
                        +
                    </div>


                    <div class="confirmation-item-info">

                        <span>
                            Medicine #@item.MedicineId
                        </span>

                        <small>
                            @item.Quantity ×
                            ₹@item.UnitPrice.ToString("0.00")
                        </small>

                    </div>


                    <strong>
                        ₹@item.Subtotal.ToString("0.00")
                    </strong>

                </div>
            }

        </div>


        <!-- TOTAL -->

        <div class="confirmation-total">

            <span>Total Amount</span>

            <strong>
                ₹@Model.TotalAmount.ToString("0.00")
            </strong>

        </div>

    </div>


    <!-- ACTIONS -->

    <div class="confirmation-actions">

        <a asp-controller="Order"
           asp-action="MyOrders"
           class="btn btn-primary">
            View My Orders
        </a>

        <a asp-controller="Medicine"
           asp-action="Index"
           class="btn btn-light">
            Continue Shopping
        </a>

    </div>

</div>







