@model EMEDS_Project.Models.Order

@{
    ViewData["Title"] = "Order Confirmation";
}

<div class="container mt-4">
    <div class="alert alert-success">
        <h3>Thank you! Your order has been placed.</h3>
    </div>

    <dl class="row">
        <dt class="col-sm-3">Order ID</dt>
        <dd class="col-sm-9">@Model.OrderId</dd>

        <dt class="col-sm-3">Order Date</dt>
        <dd class="col-sm-9">@Model.OrderDate.ToString("g")</dd>

        <dt class="col-sm-3">Delivery Address</dt>
        <dd class="col-sm-9">@Model.DeliveryAddress</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.OrderStatus</dd>

        <dt class="col-sm-3">Payment Status</dt>
        <dd class="col-sm-9">@ViewBag.PaymentStatus</dd>

        <dt class="col-sm-3">Total Amount</dt>
        <dd class="col-sm-9">@Model.TotalAmount.ToString("C")</dd>
    </dl>

    <h4>Items</h4>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Medicine ID</th>
                <th>Quantity</th>
                <th>Unit Price</th>
                <th>Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.OrderItems)
            {
                <tr>
                    <td>@item.MedicineId</td>
                    <td>@item.Quantity</td>
                    <td>@item.UnitPrice.ToString("C")</td>
                    <td>@item.Subtotal.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>

    <a asp-controller="Medicine" asp-action="Index" class="btn btn-primary">Continue Shopping</a>
</div>