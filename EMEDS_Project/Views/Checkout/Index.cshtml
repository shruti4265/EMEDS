

@model EMEDS_Project.ViewModels.CheckoutViewModel

@{
    ViewData["Title"] = "Checkout";
}

<div class="checkout-heading">

    <a asp-controller="Cart"
       asp-action="Index"
       class="checkout-back">
        ← Back to Cart
    </a>

    <span class="section-eyebrow">
        SECURE CHECKOUT
    </span>

    <h2>Complete Your Order</h2>

    <p>
        Enter your delivery information and review
        your order before placing it.
    </p>

</div>


<div asp-validation-summary="ModelOnly"
     class="alert alert-danger">
</div>


<div class="row g-4 align-items-start">

    <!-- LEFT -->

    <div class="col-lg-7">

        <div class="checkout-card">

            <div class="checkout-section-title">

                <span class="checkout-number">
                    1
                </span>

                <div>
                    <h4>Delivery Information</h4>
                    <p>
                        Tell us where your order should be delivered.
                    </p>
                </div>

            </div>


            <form asp-action="PlaceOrder"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()


                <!-- NAME -->

                <div class="mb-4">

                    <label asp-for="CustomerName"
                           class="form-label">
                    </label>

                    <input asp-for="CustomerName"
                           class="form-control"
                           placeholder="Enter your full name" />

                    <span asp-validation-for="CustomerName"
                          class="text-danger">
                    </span>

                </div>


                <!-- EMAIL + PHONE -->

                <div class="row">

                    <div class="col-md-6 mb-4">

                        <label asp-for="Email"
                               class="form-label">
                        </label>

                        <input asp-for="Email"
                               class="form-control"
                               placeholder="name@example.com" />

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6 mb-4">

                        <label asp-for="PhoneNumber"
                               class="form-label">
                        </label>

                        <input asp-for="PhoneNumber"
                               class="form-control"
                               placeholder="Enter phone number" />

                        <span asp-validation-for="PhoneNumber"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- ADDRESS -->

                <div class="mb-4">

                    <label asp-for="Address"
                           class="form-label">
                    </label>

                    <textarea asp-for="Address"
                              class="form-control"
                              rows="3"
                              placeholder="House number, street, area"></textarea>

                    <span asp-validation-for="Address"
                          class="text-danger">
                    </span>

                </div>


                <!-- CITY + PIN -->

                <div class="row">

                    <div class="col-md-6 mb-4">

                        <label asp-for="City"
                               class="form-label">
                        </label>

                        <input asp-for="City"
                               class="form-control"
                               placeholder="Enter city" />

                        <span asp-validation-for="City"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6 mb-4">

                        <label asp-for="PostalCode"
                               class="form-label">
                        </label>

                        <input asp-for="PostalCode"
                               class="form-control"
                               placeholder="Enter postal code" />

                        <span asp-validation-for="PostalCode"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- PRESCRIPTION -->

                <div class="checkout-divider"></div>

                <div class="checkout-section-title">

                    <span class="checkout-number">
                        2
                    </span>

                    <div>
                        <h4>Prescription</h4>
                        <p>
                            Upload your prescription if your order
                            contains a prescription-required medicine.
                        </p>
                    </div>

                </div>


                <div class="mb-4">

                    <label for="prescriptionFile"
                           class="form-label">
                        Upload Prescription
                    </label>

                    <input type="file"
                           id="prescriptionFile"
                           name="prescriptionFile"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,.pdf" />

                    <div class="form-text">
                        JPG, JPEG, PNG or PDF. Maximum file size: 5 MB.
                    </div>

                </div>


                <!-- PAYMENT -->

                <div class="checkout-divider"></div>


                <div class="checkout-section-title payment-heading">

                    <span class="checkout-number">
                        3
                    </span>

                    <div>
                        <h4>Payment Method</h4>
                        <p>
                            Choose how you'd like to pay.
                        </p>
                    </div>

                </div>


                <div class="mb-4">

                    <label asp-for="PaymentMethod"
                           class="form-label">
                    </label>

                    <select asp-for="PaymentMethod"
                            class="form-select">

                        <option value="">
                            -- Select Payment Method --
                        </option>

                        <option value="Cash on Delivery">
                            Cash on Delivery
                        </option>

                    </select>

                    <span asp-validation-for="PaymentMethod"
                          class="text-danger">
                    </span>

                </div>


                <div class="cod-information">

                    <div class="cod-icon">
                        ₹
                    </div>

                    <div>

                        <strong>
                            Cash on Delivery
                        </strong>

                        <p>
                            Pay for your medicines when your
                            order is delivered.
                        </p>

                    </div>

                </div>


                <!-- PRESERVE CART ITEMS -->
                @for (int i = 0; i < Model.CartItems.Count; i++)
                {
                    <input type="hidden"
                           name="CartItems[@i].MedicineId"
                           value="@Model.CartItems[i].MedicineId" />

                    <input type="hidden"
                           name="CartItems[@i].MedicineName"
                           value="@Model.CartItems[i].MedicineName" />

                    <input type="hidden"
                           name="CartItems[@i].UnitPrice"
                           value="@Model.CartItems[i].UnitPrice" />

                    <input type="hidden"
                           name="CartItems[@i].Quantity"
                           value="@Model.CartItems[i].Quantity" />
                }


                <button type="submit"
                        class="btn btn-primary btn-lg w-100 checkout-submit">

                    Place Order

                </button>

            </form>

        </div>

    </div>


    <!-- RIGHT SUMMARY -->

    <div class="col-lg-5">

        <div class="checkout-summary">

            <span class="section-eyebrow">
                YOUR ORDER
            </span>

            <h4>Order Summary</h4>


            <div class="checkout-products">

                @foreach (var item in Model.CartItems)
                {
                    <div class="checkout-product">

                        <div class="checkout-product-icon">
                            +
                        </div>

                        <div class="checkout-product-info">

                            <strong>
                                @item.MedicineName
                            </strong>

                            <small>
                                Qty: @item.Quantity
                                × ₹@item.UnitPrice.ToString("0.00")
                            </small>

                        </div>

                        <span class="checkout-product-price">
                            ₹@item.TotalPrice.ToString("0.00")
                        </span>

                    </div>
                }

            </div>


            <div class="checkout-summary-total">

                <span>Total Amount</span>

                <strong>
                    ₹@Model.TotalAmount.ToString("0.00")
                </strong>

            </div>


            <div class="checkout-safety">

                <span>✓</span>

                <div>

                    <strong>
                        Order validation
                    </strong>

                    <p>
                        Prescription-required medicines must have
                        a prescription uploaded before placing the order.
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
