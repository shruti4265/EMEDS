@model IEnumerable<EMEDS_Project.Models.Order>

@{
    ViewData["Title"] = "My Orders";
}

<div class="page-header d-flex justify-content-between align-items-start flex-wrap gap-3">

    <div>
        <span class="section-eyebrow">ORDER HISTORY</span>
        <h2>My Orders</h2>

        <p class="page-subtitle mb-0">
            View your orders and follow their delivery progress.
        </p>
    </div>

    <a asp-controller="Medicine"
       asp-action="Index"
       class="btn btn-primary">
        Browse Medicines
    </a>

</div>


@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-4">
        ✓ @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mb-4">
        @TempData["Error"]
    </div>
}


@if (!Model.Any())
{
    <div class="orders-empty-state">

        <div class="orders-empty-icon">
            O
        </div>

        <h3>No orders yet</h3>

        <p>
            You haven't placed an order yet.
            Browse medicines and add what you need to your cart.
        </p>

        <a asp-controller="Medicine"
           asp-action="Index"
           class="btn btn-primary">
            Browse Medicines
        </a>

    </div>
}
else
{
    <div class="orders-list">

        @foreach (var order in Model.OrderByDescending(x => x.OrderDate))
        {
            string statusClass =
                order.OrderStatus.ToLower();

            <div class="order-card">

                <!-- HEADER -->

                <div class="order-card-header">

                    <div class="order-number">

                        <span>ORDER</span>

                        <h4>
                            #@order.OrderId
                        </h4>

                    </div>


                    <span class="order-badge @statusClass">
                        @(order.OrderStatus == "OutForDelivery"
                            ? "Out For Delivery"
                            : order.OrderStatus)
                    </span>

                </div>


                <!-- BODY -->

                <div class="order-card-body">

                    <div class="order-card-info">

                        <div>
                            <span>Order Date</span>

                            <strong>
                                @order.OrderDate.ToString("dd MMM yyyy")
                            </strong>
                        </div>


                        <div>
                            <span>Total Amount</span>

                            <strong class="order-amount">
                                ₹@order.TotalAmount.ToString("0.00")
                            </strong>
                        </div>


                        <div class="order-address">

                            <span>Delivery Address</span>

                            <strong>
                                @order.DeliveryAddress
                            </strong>

                        </div>

                    </div>


                    <!-- MINI PROGRESS -->
                    @if (order.OrderStatus != "Cancelled")
                    {
                        string[] statuses =
                        {
                            "Pending",
                            "Confirmed",
                            "Packed",
                            "Shipped",
                            "OutForDelivery",
                            "Delivered"
                        };

                        int currentIndex =
                            Array.IndexOf(statuses, order.OrderStatus);

                        <div class="mini-order-progress">

                            @for (int i = 0; i < statuses.Length; i++)
                            {
                                bool active = i <= currentIndex;

                                <div class="mini-progress-step @(active ? "active" : "")">

                                    <span></span>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="cancelled-order-message">
                            This order has been cancelled.
                        </div>
                    }

                </div>


                <!-- FOOTER -->

                <div class="order-card-footer">

                    <span>
                        Last known status:
                        <strong>
                            @(order.OrderStatus == "OutForDelivery"
                                ? "Out For Delivery"
                                : order.OrderStatus)
                        </strong>
                    </span>

                    <a asp-action="Details"
                       asp-route-id="@order.OrderId"
                       class="btn btn-outline-primary">
                        View Order
                    </a>

                </div>

            </div>
        }

    </div>
}
