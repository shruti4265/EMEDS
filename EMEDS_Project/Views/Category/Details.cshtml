
@model EMEDS_Project.Models.Category

@{
    ViewData["Title"] = "Category Details";
}

<div class="details-back-link">
    <a asp-action="Index">
        ← Back to Categories
    </a>
</div>


<div class="simple-details-card">

    <div class="simple-details-icon">
        +
    </div>

    <span class="section-eyebrow">
        CATEGORY DETAILS
    </span>

    <h2>@Model.CategoryName</h2>

    <p class="simple-details-description">
        @(string.IsNullOrWhiteSpace(Model.Description)
            ? "No description available for this category."
            : Model.Description)
    </p>


    <div class="simple-detail-row">

        <span>Category ID</span>

        <strong>
            #@Model.CategoryId
        </strong>

    </div>


    <div class="details-actions">

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Edit"
               asp-route-id="@Model.CategoryId"
               class="btn btn-primary">
                Edit Category
            </a>
        }

        <a asp-action="Index"
           class="btn btn-light">
            Back to Categories
        </a>

    </div>

</div>


