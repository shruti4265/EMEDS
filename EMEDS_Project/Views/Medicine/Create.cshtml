@model EMEDS_Project.Models.Medicine

@{
    ViewData["Title"] = "Add Medicine";
}

<h1>Add Medicine</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="MedicineName" class="form-label"></label>
        <input asp-for="MedicineName" class="form-control" />
        <span asp-validation-for="MedicineName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CategoryId" class="form-label"></label>
        <input asp-for="CategoryId" class="form-control" type="number" />
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="SupplierId" class="form-label"></label>
        <input asp-for="SupplierId" class="form-control" type="number" />
        <span asp-validation-for="SupplierId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ImageUrl" class="form-label"></label>
        <input asp-for="ImageUrl" class="form-control" />
        <span asp-validation-for="ImageUrl" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="RequiresPrescription" class="form-check-input" />
        <label asp-for="RequiresPrescription" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary">Add Medicine</button>

    <a asp-action="Index" class="btn btn-secondary">
        Back to List
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}