
@model EMEDS_Project.Models.Medicine

@{
    ViewData["Title"] = "Delete Medicine";
}

<div class="delete-container">

    <div class="delete-card">

        <div class="delete-icon">
            !
        </div>

        <span class="section-eyebrow danger-eyebrow">
            DELETE MEDICINE
        </span>

        <h2>Delete @Model.MedicineName?</h2>

        <p class="delete-message">
            Are you sure you want to remove this medicine?
            This action cannot be undone.
        </p>


        <div class="delete-summary">

            <div>
                <span>Medicine</span>
                <strong>@Model.MedicineName</strong>
            </div>

            <div>
                <span>Price</span>
                <strong>₹@Model.Price.ToString("0.00")</strong>
            </div>

            <div>
                <span>Category</span>
                <strong>#@Model.CategoryId</strong>
            </div>

            <div>
                <span>Prescription</span>
                <strong>
                    @(Model.RequiresPrescription ? "Required" : "Not Required")
                </strong>
            </div>

        </div>


        <form asp-action="DeleteConfirmed"
              method="post">

            <input type="hidden"
                   name="id"
                   value="@Model.MedicineId" />

            <div class="delete-actions">

                <a asp-action="Index"
                   class="btn btn-light">
                    Cancel
                </a>

                <button type="submit"
                        class="btn btn-danger">
                    Delete Medicine
                </button>

            </div>

        </form>

    </div>

</div>