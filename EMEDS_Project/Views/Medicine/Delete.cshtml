@model EMEDS_Project.Models.Medicine

@{
    ViewData["Title"] = "Delete Medicine";
}

<h1>Delete Medicine</h1>

<div class="alert alert-danger">
    <h4>Are you sure you want to delete this medicine?</h4>
    <p>This action cannot be undone.</p>
</div>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Medicine Name</dt>
            <dd class="col-sm-9">@Model.MedicineName</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@Model.Description</dd>

            <dt class="col-sm-3">Price</dt>
            <dd class="col-sm-9">@Model.Price</dd>

            <dt class="col-sm-3">Category Id</dt>
            <dd class="col-sm-9">@Model.CategoryId</dd>

            <dt class="col-sm-3">Supplier Id</dt>
            <dd class="col-sm-9">@Model.SupplierId</dd>

            <dt class="col-sm-3">Prescription Required</dt>
            <dd class="col-sm-9">
                @(Model.RequiresPrescription ? "Yes" : "No")
            </dd>
        </dl>
    </div>
</div>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden"
           name="id"
           value="@Model.MedicineId" />

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>
</form>