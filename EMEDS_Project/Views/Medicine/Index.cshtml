
@model IEnumerable<EMEDS_Project.Models.Medicine>


@{
    ViewData["Title"] = "Medicines";

}
    

<div class="page-header d-flex justify-content-between align-items-start flex-wrap gap-3">
    <div>
        <span class="section-eyebrow">MEDICINE CATALOGUE</span>
        <h2>Medicines</h2>
        <p class="page-subtitle mb-0">
            Browse and manage medicines available on E-MEDS.
        </p>
    </div>

    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary">
            + Add Medicine
        </a>
    }
</div>


<!-- SEARCH -->

<div class="medicine-search-panel">

    <form asp-action="Search" method="get">

        <div class="medicine-search-box">

            <div class="search-symbol">
                ⌕
            </div>

            <input type="text"
                   name="searchTerm"
                   class="form-control medicine-search-input"
                   placeholder="Search medicine by name..." />

            <button type="submit"
                    class="btn btn-primary">
                Search
            </button>

            <a asp-action="Index"
               class="btn btn-light">
                Clear
            </a>

        </div>

    </form>

</div>


@if (!Model.Any())
{
    <div class="emeds-empty-state">

        <div class="empty-state-icon">
            +
        </div>

        <h4>No medicines found</h4>

        <p>
            We couldn't find any medicines matching your search.
        </p>

        <a asp-action="Index"
           class="btn btn-outline-primary">
            View All Medicines
        </a>

    </div>
}
else
{
    <div class="medicine-grid">

        @foreach (var medicine in Model)
        {

            <div class="medicine-card">

                <!-- IMAGE -->

                <div class="medicine-image-area">

                    @if (!string.IsNullOrWhiteSpace(medicine.ImageUrl))
                    {
                        <img src="@medicine.ImageUrl"
                             alt="@medicine.MedicineName"
                             class="medicine-image" />
                    }
                    else
                    {
                        <div class="medicine-placeholder">
                            <span>+</span>
                            <small>E-MEDS</small>
                        </div>
                    }

                    @if (medicine.RequiresPrescription)
                    {
                        <span class="prescription-tag">
                            Rx Required
                        </span>
                    }
                    else
                    {
                        <span class="otc-tag">
                            No Prescription
                        </span>
                    }

                </div>


                <!-- BODY -->

                <div class="medicine-card-body">

                    <div class="medicine-meta">
                        Medicine #@medicine.MedicineId
                    </div>

                    <h3 class="medicine-name">
                        @medicine.MedicineName
                    </h3>

                    <p class="medicine-description">
                        @(string.IsNullOrWhiteSpace(medicine.Description)
                            ? "No description available."
                            : medicine.Description)
                    </p>


                    <div class="medicine-info-row">

                        <div>
                            <span class="medicine-info-label">
                                Category
                            </span>

                            <strong>
                                @(medicine.Category?.CategoryName
                                    ?? $"Category #{medicine.CategoryId}")
                            </strong>
                        </div>

                        <div>
                            <span class="medicine-info-label">
                                Supplier
                            </span>

                            <strong>
                                #@medicine.SupplierId
                            </strong>
                        </div>

                    </div>


                    <div class="medicine-card-footer">

                        <div class="medicine-price">
                            <small>Price</small>
                            <span>₹@medicine.Price.ToString("0.00")</span>
                        </div>


                        <a asp-action="Details"
                           asp-route-id="@medicine.MedicineId"
                           class="btn btn-outline-primary btn-sm">
                            Details
                        </a>

                    </div>


               




                    @if (!User.IsInRole("Admin"))
                    {
                        <div class="medicine-main-action">

                            <form asp-controller="Cart"
                                  asp-action="AddToCart"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="medicineId"
                                       value="@medicine.MedicineId" />

                                <button type="submit"
                                        class="btn btn-primary w-100">

                                    Add to Cart

                                </button>

                            </form>

                            @if (medicine.RequiresPrescription)
                            {
                                <div class="mt-2 text-center">

                                    <small class="text-muted">
                                        Prescription required. You can upload it after placing your order.
                                    </small>

                                </div>
                            }

                        </div>
                    }





                    <!-- ADMIN ACTIONS -->
                    @if (User.IsInRole("Admin"))
                    {
                        <div class="medicine-admin-actions">

                            <a asp-action="Edit"
                               asp-route-id="@medicine.MedicineId"
                               class="btn btn-light btn-sm">
                                Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@medicine.MedicineId"
                               class="btn btn-outline-danger btn-sm">
                                Delete
                            </a>

                        </div>
                    }

                </div>

            </div>
        }

    </div>
}
