@model EMEDS_Project.Models.Inventory

@{
    ViewData["Title"] = "Add Inventory";
}

<div class="container-fluid px-0">

    <div class="mb-3">
        <a asp-action="Index"
           class="text-decoration-none text-muted">
            ← Back to Inventory
        </a>
    </div>

    <div class="row justify-content-center">

        <div class="col-lg-8 col-xl-7">

            <div class="mb-4">
                <span class="section-eyebrow">INVENTORY</span>

                <h2 class="fw-bold mb-1">Add Inventory</h2>

                <p class="text-muted mb-0">
                    Create a new inventory record for a medicine.
                </p>
            </div>

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-header bg-white p-4">
                    <h5 class="fw-bold mb-1">Inventory Information</h5>
                    <small class="text-muted">
                        Select the medicine and enter its stock information.
                    </small>
                </div>

                <div class="card-body p-4 p-md-5">

                    <form asp-action="Create" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"></div>

                        <!-- MEDICINE -->
                        <div class="mb-4">
                            <label asp-for="MedicineId"
                                   class="form-label fw-semibold">
                                Medicine
                            </label>

                            <select asp-for="MedicineId"
                                    asp-items="ViewBag.Medicines"
                                    class="form-select">
                                <option value="">-- Select Medicine --</option>
                            </select>

                            <span asp-validation-for="MedicineId"
                                  class="text-danger small"></span>

                            <div class="form-text">
                                Each medicine can have only one inventory record.
                            </div>
                        </div>

                        <!-- SUPPLIER -->
                        <div class="mb-4">
                            <label asp-for="SupplierId"
                                   class="form-label fw-semibold">
                                Supplier
                            </label>

                            <select asp-for="SupplierId"
                                    asp-items="ViewBag.Suppliers"
                                    class="form-select">
                                <option value="">-- Select Supplier (optional) --</option>
                            </select>
                        </div>

                        <div class="row g-3">

                            <!-- STOCK -->
                            <div class="col-md-6">

                                <div class="mb-4">
                                    <label asp-for="StockQuantity"
                                           class="form-label fw-semibold">
                                        Stock Quantity
                                    </label>

                                    <div class="input-group">
                                        <input asp-for="StockQuantity"
                                               class="form-control"
                                               min="0" />

                                        <span class="input-group-text">
                                            units
                                        </span>
                                    </div>

                                    <span asp-validation-for="StockQuantity"
                                          class="text-danger small"></span>
                                </div>

                            </div>

                            <!-- REORDER -->
                            <div class="col-md-6">

                                <div class="mb-4">
                                    <label asp-for="ReorderLevel"
                                           class="form-label fw-semibold">
                                        Reorder Level
                                    </label>

                                    <div class="input-group">
                                        <input asp-for="ReorderLevel"
                                               class="form-control"
                                               min="0" />

                                        <span class="input-group-text">
                                            units
                                        </span>
                                    </div>

                                    <span asp-validation-for="ReorderLevel"
                                          class="text-danger small"></span>
                                </div>

                            </div>

                        </div>

                        <div class="alert inventory-info-alert">
                            <strong>Reorder Level:</strong>
                            When stock quantity reaches or falls below this
                            value, the medicine will appear in the Low Stock list.
                        </div>

                        <div class="d-flex gap-2 flex-wrap mt-4">

                            <button type="submit"
                                    class="btn btn-primary px-4">
                                Add Inventory
                            </button>

                            <a asp-action="Index"
                               class="btn btn-light px-4">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}