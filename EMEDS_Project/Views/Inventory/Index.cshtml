@model IEnumerable<EMEDS_Project.Models.Inventory>

@{
    ViewData["Title"] = "Inventory";

    int totalItems = Model.Count();
    int lowStockItems = Model.Count(x => x.StockQuantity <= x.ReorderLevel);
    int inStockItems = Model.Count(x => x.StockQuantity > x.ReorderLevel);
    int totalStock = Model.Sum(x => x.StockQuantity);
}

<div class="container-fluid px-0">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>
            <span class="section-eyebrow">
                ADMINISTRATION
            </span>

            <h2 class="fw-bold mb-1">
                Inventory Management
            </h2>

            <p class="text-muted mb-0">
                Monitor medicine stock levels and manage inventory.
            </p>
        </div>

        <div class="d-flex gap-2 flex-wrap">

            <a asp-action="LowStock"
               class="btn btn-outline-danger px-3">
                Low Stock
            </a>

            <a asp-action="Create"
               class="btn btn-primary px-3">
                + Add Inventory
            </a>

        </div>

    </div>


    <!-- INVENTORY STATISTICS -->
    <div class="row g-3 mb-4">

        <!-- TOTAL INVENTORY -->
        <div class="col-6 col-lg-3">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body p-4">

                    <small class="text-muted d-block mb-2">
                        Total Inventory
                    </small>

                    <h2 class="inventory-stat-number fw-bold mb-1">
                        @totalItems
                    </h2>

                    <small class="text-muted">
                        Medicine records
                    </small>

                </div>

            </div>

        </div>


        <!-- TOTAL STOCK -->
        <div class="col-6 col-lg-3">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body p-4">

                    <small class="text-muted d-block mb-2">
                        Total Stock
                    </small>

                    <h2 class="inventory-stat-number fw-bold mb-1">
                        @totalStock
                    </h2>

                    <small class="text-muted">
                        Units available
                    </small>

                </div>

            </div>

        </div>


        <!-- HEALTHY STOCK -->
        <div class="col-6 col-lg-3">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body p-4">

                    <small class="text-muted d-block mb-2">
                        Healthy Stock
                    </small>

                    <h2 class="inventory-stat-number fw-bold mb-1">
                        @inStockItems
                    </h2>

                    <small class="text-muted">
                        Above reorder level
                    </small>

                </div>

            </div>

        </div>


        <!-- LOW STOCK -->
        <div class="col-6 col-lg-3">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body p-4">

                    <small class="text-muted d-block mb-2">
                        Low Stock
                    </small>

                    <h2 class="fw-bold mb-1 text-danger">
                        @lowStockItems
                    </h2>

                    <small class="text-muted">
                        Needs attention
                    </small>

                </div>

            </div>

        </div>

    </div>


    <!-- INVENTORY TABLE CARD -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

        <div class="card-header bg-white p-4">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h5 class="fw-bold mb-1">
                        Inventory Records
                    </h5>

                    <small class="text-muted">
                        @totalItems item@(totalItems == 1 ? "" : "s") found
                    </small>

                </div>

            </div>

        </div>


        @if (!Model.Any())
        {
            <!-- EMPTY STATE -->
            <div class="card-body text-center py-5">

                <div class="inventory-empty-icon mx-auto mb-3">
                    Rx
                </div>

                <h5 class="fw-bold mb-2">
                    No Inventory Records
                </h5>

                <p class="text-muted mb-4">
                    Add inventory records to start tracking medicine stock.
                </p>

                <a asp-action="Create"
                   class="btn btn-primary px-4">
                    + Add Inventory
                </a>

            </div>
        }
        else
        {
            <!-- TABLE -->
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>
                            <th class="ps-4">Inventory</th>
                            <th>Medicine ID</th>
                            <th>Supplier</th>
                            <th>Stock</th>
                            <th>Reorder Level</th>
                            <th>Status</th>
                            <th>Last Updated</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item in Model)
                        {
                            bool isLowStock =
                                item.StockQuantity <= item.ReorderLevel;

                            <tr>

                                <!-- INVENTORY ID -->
                                <td class="ps-4">

                                    <div class="d-flex align-items-center gap-3">

                                        <div class="inventory-table-icon">
                                            Rx
                                        </div>

                                        <div>

                                            <strong class="d-block">
                                                #@item.InventoryId
                                            </strong>

                                            <small class="text-muted">
                                                Inventory
                                            </small>

                                        </div>

                                    </div>

                                </td>


                                <!-- MEDICINE ID -->
                                <td>

                                    <strong>
                                        #@item.MedicineId
                                    </strong>

                                </td>


                                <!-- SUPPLIER -->
                                <td>

                                    @if (item.Supplier != null)
                                    {
                                        <span>
                                            @item.Supplier.SupplierName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Not Assigned
                                        </span>
                                    }

                                </td>


                                <!-- STOCK -->
                                <td>

                                    <strong class="@(isLowStock ? "text-danger" : "")">
                                        @item.StockQuantity
                                    </strong>

                                    <small class="text-muted">
                                        units
                                    </small>

                                </td>


                                <!-- REORDER LEVEL -->
                                <td>

                                    @item.ReorderLevel

                                    <small class="text-muted">
                                        units
                                    </small>

                                </td>


                                <!-- STOCK STATUS -->
                                <td>

                                    @if (isLowStock)
                                    {
                                        <span class="badge rounded-pill bg-danger-subtle text-danger px-3 py-2">
                                            Low Stock
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2">
                                            In Stock
                                        </span>
                                    }

                                </td>


                                <!-- LAST UPDATED -->
                                <td>

                                    <span class="d-block">
                                        @item.LastUpdated.ToString("dd MMM yyyy")
                                    </span>

                                    <small class="text-muted">
                                        @item.LastUpdated.ToString("hh:mm tt")
                                    </small>

                                </td>


                                <!-- ACTIONS -->
                                <td class="text-end pe-4">

                                    <div class="d-flex justify-content-end gap-2">

                                        <a asp-action="Details"
                                           asp-route-id="@item.InventoryId"
                                           class="btn btn-outline-primary btn-sm">
                                            Details
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.InventoryId"
                                           class="btn btn-outline-secondary btn-sm">
                                            Edit
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>