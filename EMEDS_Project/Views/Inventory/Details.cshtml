@model EMEDS_Project.Models.Inventory

@{
    ViewData["Title"] = "Inventory Details";
}

<div class="container mt-4">
    <h2>Inventory Details</h2>

    <dl class="row">
        <dt class="col-sm-3">Inventory ID</dt>
        <dd class="col-sm-9">@Model.InventoryId</dd>

        <dt class="col-sm-3">Medicine ID</dt>
        <dd class="col-sm-9">@Model.MedicineId</dd>

        <dt class="col-sm-3">Supplier</dt>
        <dd class="col-sm-9">@(Model.Supplier?.SupplierName ?? "Not assigned")</dd>

        <dt class="col-sm-3">Stock Quantity</dt>
        <dd class="col-sm-9">@Model.StockQuantity</dd>

        <dt class="col-sm-3">Reorder Level</dt>
        <dd class="col-sm-9">@Model.ReorderLevel</dd>

        <dt class="col-sm-3">Last Updated</dt>
        <dd class="col-sm-9">@Model.LastUpdated.ToString("g")</dd>
    </dl>

    <a asp-action="Index" class="btn btn-secondary">Back</a>
    <a asp-action="Edit" asp-route-id="@Model.InventoryId" class="btn btn-warning">Edit</a>
</div>