@model EMEDS_Project.ViewModels.ChatbotViewModel

@{
    ViewData["Title"] = "EMEDS Help Assistant";
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-xl-9 col-lg-10">

            <!-- PAGE HEADER -->
            <div class="text-center mb-4">

                <div class="chatbot-page-icon mx-auto mb-3">
                    <i class="bi bi-chat-dots-fill"></i>
                </div>

                <span class="section-eyebrow">
                    E-MEDS SUPPORT
                </span>

                <h2 class="fw-bold mb-2">
                    How can we help?
                </h2>

                <p class="text-muted mb-0">
                    Choose a question below to get instant help with E-MEDS.
                </p>

            </div>


            <div class="row g-4">

                <!-- CHAT AREA -->
                <div class="col-lg-7">

                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">

                        <!-- HEADER -->
                        <div class="chatbot-header p-4">

                            <div class="d-flex align-items-center gap-3">

                                <div class="chatbot-avatar">
                                    <i class="bi bi-chat-heart-fill"></i>
                                </div>

                                <div>
                                    <h5 class="fw-bold mb-1 text-white">
                                        E-MEDS Assistant
                                    </h5>

                                    <div class="d-flex align-items-center gap-2">
                                        <span class="chatbot-online-dot"></span>

                                        <small>
                                            Online • Ready to help
                                        </small>
                                    </div>
                                </div>

                            </div>

                        </div>


                        <!-- CONVERSATION -->
                        <div class="card-body p-4 chatbot-conversation">

                            <!-- WELCOME -->
                            <div class="d-flex align-items-start gap-2 mb-4">

                                <div class="chatbot-small-avatar">
                                    E+
                                </div>

                                <div class="chatbot-bot-message">

                                    <small class="chatbot-message-name">
                                        E-MEDS Assistant
                                    </small>

                                    <p class="mb-0 mt-1">
                                        Hi! 👋 I'm the E-MEDS Help Assistant.
                                        Select one of the available questions
                                        and I'll help you.
                                    </p>

                                </div>

                            </div>


                            <!-- USER QUESTION -->
                            @if (!string.IsNullOrEmpty(Model.Question))
                            {
                                <div class="d-flex justify-content-end mb-3">

                                    <div class="chatbot-user-message">

                                        <small class="d-block mb-1">
                                            You
                                        </small>

                                        @Model.Question

                                    </div>

                                </div>
                            }


                            <!-- BOT ANSWER -->
                            @if (!string.IsNullOrEmpty(Model.Answer))
                            {
                                <div class="d-flex align-items-start gap-2 mb-3">

                                    <div class="chatbot-small-avatar">
                                        E+
                                    </div>

                                    <div class="chatbot-bot-message">

                                        <small class="chatbot-message-name">
                                            E-MEDS Assistant
                                        </small>

                                        <p class="mb-0 mt-1">
                                            @Model.Answer
                                        </p>

                                    </div>

                                </div>
                            }


                            @if (string.IsNullOrEmpty(Model.Question))
                            {
                                <div class="chatbot-hint mt-4">

                                    <i class="bi bi-info-circle me-2"></i>

                                    This assistant answers common questions
                                    about medicines, prescriptions, orders and
                                    payments.

                                </div>
                            }

                        </div>

                    </div>

                </div>


                <!-- QUESTIONS -->
                <div class="col-lg-5">

                    <div class="card border-0 shadow-sm rounded-4 h-100">

                        <div class="card-header bg-white p-4">

                            <h5 class="fw-bold mb-1">
                                Frequently Asked Questions
                            </h5>

                            <small class="text-muted">
                                Select a question to continue
                            </small>

                        </div>


                        <div class="card-body p-3">

                            <div class="chatbot-question-list">

                                @foreach (var question in Model.Questions)
                                {
                                    <form asp-controller="Chatbot"
                                          asp-action="Index"
                                          method="post"
                                          class="mb-2">

                                        <input type="hidden"
                                               name="question"
                                               value="@question" />

                                        <button type="submit"
                                                class="chatbot-question-btn">

                                            <span class="chatbot-question-icon">
                                                <i class="bi bi-question-lg"></i>
                                            </span>

                                            <span class="flex-grow-1">
                                                @question
                                            </span>

                                            <i class="bi bi-chevron-right chatbot-arrow"></i>

                                        </button>

                                    </form>
                                }

                            </div>

                        </div>


                        <div class="card-footer bg-white border-top p-3 text-center">

                            <small class="text-muted">
                                <i class="bi bi-shield-check me-1"></i>
                                E-MEDS Help & Support
                            </small>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>